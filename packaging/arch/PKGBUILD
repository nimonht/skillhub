# Maintainer: nimonht
pkgname=skillhub
pkgver=1.0.0
pkgrel=1
pkgdesc='One skills folder for every coding agent: native Qt6 manager and CLI'
arch=('x86_64' 'aarch64')
url='https://github.com/nimonht/skillhub'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'git')
makedepends=('python')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  qmake6 PREFIX=/usr skillhub.pro
  make
}

check() {
  cd "$pkgname-$pkgver"
  sh tests/smoke.sh ./skillhub
  python tests/portable_smoke.py ./skillhub
  python3 tests/contrast.py
}

package() {
  cd "$pkgname-$pkgver"
  make INSTALL_ROOT="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
  for f in data/LICENSE-vercel-labs-skills data/LICENSE-lobe-icons data/LICENSE-simple-icons fonts/OFL.txt; do
    install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$(basename "$f")"
  done
}
