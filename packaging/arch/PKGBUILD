# Maintainer: nimonht
pkgname=skillhub
pkgver=2.0.0beta3
_tag=2.0.0-beta3  # pacman forbids a hyphen in pkgver, and 2.0.0beta1 sorts before 2.0.0
pkgrel=1
pkgdesc='One skills folder for every coding agent: a C command line and a native Qt6 window'
arch=('x86_64' 'aarch64')
url='https://github.com/nimonht/skillhub'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'git' 'libuv')
makedepends=('cmake' 'python' 'pkgconf' 'qt6-shadertools')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$_tag.tar.gz")
sha256sums=('d5f9d2320a3ed24aa4fdcd0a34bb9c79334661d63ceae5179a9d2e0524397e68')

build() {
  cmake -B build -S "$pkgname-$_tag" -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None -Wno-dev
  cmake --build build
}

check() {
  cd "$pkgname-$_tag"
  sh tests/smoke.sh ../build/skillhub
  python tests/portable_smoke.py ../build/skillhub
  python3 tests/contrast.py
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  cd "$pkgname-$_tag"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
  for f in data/LICENSE-vercel-labs-skills data/LICENSE-lobe-icons data/LICENSE-simple-icons fonts/OFL.txt; do
    install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$(basename "$f")"
  done
}
