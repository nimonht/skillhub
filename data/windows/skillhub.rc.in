// Generated by CMake for @SKILLHUB_EXE@.exe: icon and version information.
#include <winver.h>

IDI_ICON1 ICON "@SKILLHUB_ICO@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "nimonht"
            VALUE "FileDescription", "@SKILLHUB_EXE_DESCRIPTION@"
            VALUE "FileVersion", "@SKILLHUB_VERSION@"
            VALUE "InternalName", "@SKILLHUB_EXE@"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "@SKILLHUB_EXE@.exe"
            VALUE "ProductName", "Skill Hub"
            VALUE "ProductVersion", "@SKILLHUB_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
